# Gaia Link Agent 環境變數

# Server
PORT=3001
NODE_ENV=development

# LLM Provider (OpenAI / Anthropic / DeepSeek)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# Polymarket API (Optional)
POLYMARKET_API_URL=https://clob.polymarket.com

# News API (Optional)
NEWS_API_KEY=xxx

# =============================================================================
# Blockchain Configuration
# =============================================================================

# 服務模式切換
# - false (默認): 使用 Mock 服務，無需真實區塊鏈
# - true: 使用真實區塊鏈服務 (需要配置以下參數)
USE_BLOCKCHAIN=false

# Network
CHAIN_ID=31337                                    # 31337 = Anvil (local), 1 = Mainnet
RPC_URL=http://127.0.0.1:8545                     # Anvil default

# Contract Addresses (從 forge script 部署後獲取)
CHARITY_REGISTRY_ADDRESS=0x...
PROPOSAL_MANAGER_ADDRESS=0x...
USDC_TOKEN_ADDRESS=0x...

# Wallet (用於簽署交易)
WALLET_PRIVATE_KEY=0x...                          # Anvil test key: 0xac0974bec...

# Gas Settings (可選)
GAS_LIMIT=500000
