# Gaia Link Agent Environment Variables

# ====================
# LLM Provider Configuration
# ====================
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Alternative LLM Providers
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GOOGLE_API_KEY=your-google-api-key

# ====================
# Blockchain Configuration
# ====================

# Network selection: mock, sepolia, mainnet
# - mock: Simulated transactions (default, for testing/demo)
# - sepolia: Ethereum Sepolia testnet (requires RPC URL and private key)
# - mainnet: Ethereum mainnet (not yet supported)
BLOCKCHAIN_NETWORK=mock

# Sepolia Testnet RPC URL
# Get free RPC from: Alchemy, Infura, or QuickNode
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Wallet Private Key (TESTNET ONLY!)
# WARNING: Never use a wallet with real funds
# Create a dedicated test wallet for development
WALLET_PRIVATE_KEY=your_test_wallet_private_key_here

# ====================
# API Configuration
# ====================

# Polymarket API URL
POLYMARKET_API_URL=https://clob.polymarket.com

# ====================
# Logging Configuration
# ====================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable audit logging (records all operations)
AUDIT_LOGGING_ENABLED=false

# ====================
# Rate Limiting
# ====================

# Enable request rate limiting
RATE_LIMIT_ENABLED=false

# Maximum requests per minute
RATE_LIMIT_REQUESTS_PER_MINUTE=60
